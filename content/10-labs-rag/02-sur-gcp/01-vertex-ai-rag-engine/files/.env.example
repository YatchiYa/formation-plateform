# Copiez en .env. Identifiants : gcloud auth application-default login (aucune clé d'API ici).
GOOGLE_CLOUD_PROJECT=mon-projet-demo
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# RAG Engine est GA en europe-west3 et europe-west4 (europe-west1 : préversion sur liste d'autorisation)
GOOGLE_CLOUD_LOCATION=europe-west4
RAG_LOCATION=europe-west4
MODEL=gemini-2.5-flash
CHUNK_SIZE=300
CHUNK_OVERLAP=50
# Rempli après « python rag_engine_lab.py setup » (utilisé par agent.py)
RAG_CORPUS=projects/123456789/locations/europe-west4/ragCorpora/0000000000
