# Copiez ce fichier en .env et adaptez. Identifiants : gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=votre-projet-id
GOOGLE_CLOUD_LOCATION=europe-west1
MODEL=gemini-2.5-flash
# Plafond d'octets par requête BigQuery (1 Go ; minimum accepté : 10485760)
MAX_OCTETS=1000000000
