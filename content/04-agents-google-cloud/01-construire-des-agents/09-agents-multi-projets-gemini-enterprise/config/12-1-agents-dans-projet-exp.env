# Scénario 12-1 : les agents dans un projet À PART, l'app Gemini Enterprise dans un autre.
# Seul fichier à modifier. Chargement : source scripts/config.sh config/12-1-agents-dans-projet-exp.env

# Projet de l'app Gemini Enterprise. Pas encore d'app ? Laissez PROJET_APP, NUM_APP et APP_ID VIDES
# (déploiement des agents seuls : docs/12-1-1, 12-1-2, 12-1-3), et PUBLIER=non.
PROJET_APP=project-b8512cca-6e9f-416f-9f3
NUM_APP=943667532373
APP_ID=dev_gemini-entreprise-app         # Gemini Enterprise > l'app > Présentation : ID de l'app
GE_LOCATION=eu                          # localisation de l'app (multi-région eu)

# Projet des agents (Agent Runtime, Cloud Run A2A)
PROJET_AGENTS=second-pr-511015
NUM_AGENTS=1016292184448
REGION=europe-west1                     # app eu => agents en europe-*

# Les agents à déployer : leurs clés dans agents/trio/catalogue.json, séparées par des espaces.
# Vide = TOUS les agents du catalogue. Exemples : AGENTS="meteo"   AGENTS="meteo taille"
# Attention (Terraform) : retirer une clé de cette liste SUPPRIME l'agent déjà déployé.
AGENTS="meteo taille"

# Publier les agents dans l'app avec Terraform ? non au premier déploiement, oui à l'étape « Connecter »
PUBLIER=non

# Agents qui agissent avec le compte de l'utilisateur (OAuth) : "clé_agent=ID_autorisation", séparés par des espaces.
# Vide au départ. L'autorisation se crée d'abord dans l'app (docs/12-3, partie C). Ex. : AGENTS_OAUTH="docs=acces-drive"
AGENTS_OAUTH=""

# Groupe Google qui aura accès aux agents dans l'app (rôle Agent User)
GROUPE_UTILISATEURS="equipe-agents@acme.example"

# Dossier du projet sur votre poste
DOSSIER=/home/yarab/Bureau/trash/09-agents-multi-projets-gemini-enterprise
