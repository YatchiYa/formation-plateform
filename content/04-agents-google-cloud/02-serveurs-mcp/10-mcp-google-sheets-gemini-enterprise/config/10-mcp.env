# Configuration du projet 10 (serveur MCP Google Sheets + agent), lue par : source scripts/config.sh config/10-mcp.env
# Une valeur par ligne, sans espace autour du « = ». Rien de secret ici (le secret du client OAuth n'est JAMAIS dans ce fichier).

# --- Le projet qui héberge le serveur MCP et l'agent (le « projet des agents », comme au projet 09) ---
PROJET=aiml-gemini-ent-exp-0zga          # ID du projet (console : sélecteur de projet, colonne ID)
NUM_PROJET=433175138344                  # son NUMÉRO (console : Tableau de bord > Informations sur le projet)
REGION=europe-west1                      # app Gemini Enterprise en « eu » => région europe-*

# --- L'app Gemini Enterprise (peut rester vide tant qu'on ne branche pas ; les scripts le disent) ---
PROJET_APP=                              # ex. acme-gemini-prod
NUM_APP=                                 # ex. 523307489860 (compte de l'app : service-<NUM_APP>@gcp-sa-discoveryengine…)
APP_ID=                                  # ex. gemini-enterprise-app
GE_LOCATION=eu

# --- Qui le serveur MCP accepte (jeton OAuth de l'utilisateur) ---
# ID du (des) client(s) OAuth dont on accepte les jetons : celui du connecteur et/ou de l'autorisation de l'agent.
# Plusieurs : séparés par des virgules. Vide au premier déploiement : le serveur refuse alors de démarrer (sécurité),
# remplissez-le après avoir créé le client OAuth (docs/10-5, étape 1).
OAUTH_CLIENT_IDS=
ALLOWED_DOMAINS=acme.example            # domaines des comptes acceptés (plusieurs : virgules)

# --- L'agent ---
AUTH_ID=acces-sheets                     # ID de l'autorisation OAuth de l'agent dans l'app (docs/10-6)
MODEL=gemini-3.5-flash
REGISTRE_LOCATION=europe-west1           # Agent Registry (pas « eu » ni « us » : région ou global)
