# Mode « sans GCP » : clé Google AI Studio
GOOGLE_API_KEY=votre-cle-ici
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Mode « avec GCP » : décommentez et supprimez GOOGLE_API_KEY
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=mon-projet
# GOOGLE_CLOUD_LOCATION=europe-west1
MODEL=gemini-3.5-flash
# Jeton partagé entre agents (générez-le : python -c "import secrets; print(secrets.token_urlsafe(32))")
A2A_TOKEN=remplacez-moi-par-un-jeton-long-et-aleatoire
A2A_TIMEOUT=30
