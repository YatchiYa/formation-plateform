# Copiez ce fichier en .env (ne le committez jamais).
# Mode « sans GCP » : clé créée dans Google AI Studio
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=remplacez-par-votre-cle
MODEL=gemini-3.5-flash

# Mode « avec GCP » : Vertex AI (après gcloud auth application-default login)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=mon-projet
# GOOGLE_CLOUD_LOCATION=europe-west1
# MODEL=gemini-2.5-flash

# Garde-fous
MAX_APPELS_LLM=25
MAX_ITERATIONS=3
