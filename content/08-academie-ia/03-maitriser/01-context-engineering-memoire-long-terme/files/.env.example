# Copiez en .env. Mode « clé d'API » (Google AI Studio) :
GOOGLE_API_KEY=votre-cle-ici
MODEL=gemini-3.5-flash
EXTRACT_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
RECALL_K=4

# Mode « Vertex AI » (identifiants ADC, pas de clé) : décommentez et retirez GOOGLE_API_KEY
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=votre-projet
# GOOGLE_CLOUD_LOCATION=europe-west1
# MODEL=gemini-2.5-flash
# EXTRACT_MODEL=gemini-2.5-flash-lite
# EMBED_MODEL=gemini-embedding-001
