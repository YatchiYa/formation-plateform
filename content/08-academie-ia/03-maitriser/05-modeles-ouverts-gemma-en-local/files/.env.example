# Copiez ce fichier en .env (ne le committez jamais).
# Fournisseur : gemini (défaut), vertex, ollama, llamacpp, lmstudio
LLM_FOURNISSEUR=gemini

# gemini : clé créée dans Google AI Studio (sert pour Gemma ET Gemini)
GEMINI_API_KEY=remplacez-par-votre-cle

# vertex : après gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=mon-projet
# GOOGLE_CLOUD_LOCATION=europe-west1

# Tout autre serveur compatible OpenAI (vLLM, Cloud Run…) :
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=local
