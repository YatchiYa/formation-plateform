{
  "displayName": "lab-llmops - appels LLM",
  "labels": {"formation-lab": "llmops"},
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {"width": 6, "height": 4, "widget": {"title": "Latence p95 par version de prompt (ms)",
        "xyChart": {"dataSets": [{"plotType": "LINE", "timeSeriesQuery": {"timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/lab-llmops-latence\"",
          "aggregation": {"alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_PERCENTILE_95",
                          "crossSeriesReducer": "REDUCE_MAX", "groupByFields": ["metric.label.prompt_version"]}}}}]}}},
      {"xPos": 6, "width": 6, "height": 4, "widget": {"title": "Appels en erreur (par 5 min)",
        "xyChart": {"dataSets": [{"plotType": "STACKED_BAR", "timeSeriesQuery": {"timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/lab-llmops-erreurs\"",
          "aggregation": {"alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_SUM",
                          "crossSeriesReducer": "REDUCE_SUM"}}}}]}}}
    ]
  }
}
