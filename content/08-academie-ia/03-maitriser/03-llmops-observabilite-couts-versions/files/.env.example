# Mode « clé d'API » (Google AI Studio)
GOOGLE_API_KEY=votre-cle-ici
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Mode « Vertex AI » (identifiants : gcloud auth application-default login)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=mon-projet
# GOOGLE_CLOUD_LOCATION=europe-west1

# Observabilité
OTEL_EXPORTER=console          # console | gcp | none
APP_VERSION=dev
LLM_LOG=calls.jsonl
