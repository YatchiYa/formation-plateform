# Copier en .env pour le développement local (ne jamais committer .env)
# Mode local : API Gemini avec une clé créée dans Google AI Studio
GOOGLE_API_KEY=remplacez-par-votre-cle
GOOGLE_GENAI_USE_VERTEXAI=FALSE
MODEL=gemini-3.5-flash
LLM_TIMEOUT_S=20

# Mode Vertex AI (sans clé, identité Google Cloud) : supprimer GOOGLE_API_KEY et mettre
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=mon-projet
# GOOGLE_CLOUD_LOCATION=europe-west1
# MODEL=gemini-2.5-flash
