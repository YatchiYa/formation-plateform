# Copiez ce fichier en .env (jamais versionné) et choisissez UN des deux modes.

# Mode « sans GCP » : clé d'API Gemini (Google AI Studio)
GOOGLE_API_KEY=votre-cle-api-gemini
MODEL=gemini-3.5-flash

# Mode « avec GCP » : Vertex AI (après `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=mon-projet
# GOOGLE_CLOUD_LOCATION=europe-west1
# MODEL=gemini-2.5-flash
