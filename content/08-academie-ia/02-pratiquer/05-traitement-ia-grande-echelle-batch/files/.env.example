# Copier en .env (ne jamais committer .env)
GOOGLE_API_KEY=remplacez-par-votre-cle
GOOGLE_GENAI_USE_VERTEXAI=FALSE
MODEL=gemini-3.5-flash-lite

# Prix en dollars par million de jetons, À RECOPIER depuis la page Tarifs du modèle choisi
# (https://ai.google.dev/gemini-api/docs/pricing). Valeurs ci-dessous : exemples à remplacer.
PRICE_IN_PER_M=0.10
PRICE_OUT_PER_M=0.40

