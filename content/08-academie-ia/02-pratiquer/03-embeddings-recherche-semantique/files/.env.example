# Mode « sans GCP » : clé créée dans Google AI Studio
GOOGLE_API_KEY=votre-cle-ici
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Mode « avec GCP » (Vertex AI) : commentez les 2 lignes ci-dessus, puis
# gcloud auth application-default login
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=mon-projet
# GOOGLE_CLOUD_LOCATION=global        # gemini-embedding-2 est servi en « global »
# BQ_LOCATION=europe-west1            # pour bigquery_vector_search.py

EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
INDEX_DIR=index
