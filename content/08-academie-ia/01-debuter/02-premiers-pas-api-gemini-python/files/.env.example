# Copiez ce fichier en .env puis remplacez les valeurs factices.

# --- Mode 1 : clé d'API (Google AI Studio) ---
GEMINI_API_KEY=votre-cle-ai-studio-ici

# --- Mode 2 : Vertex AI (décommentez ces 2 lignes ; connexion : gcloud auth application-default login) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=mon-projet-gcp
# Facultatif : région (défaut « global »). En europe-west1, utilisez MODEL=gemini-2.5-flash.
# GOOGLE_CLOUD_LOCATION=europe-west1

# MODEL=gemini-3.5-flash
# TEMPERATURE=0.2   # facultatif, ignoré par Gemini 3.6+
# Prix d'exemple en $ par million de tokens : recopiez ceux de la page tarifs
# PRIX_ENTREE_1M=0.30
# PRIX_SORTIE_1M=2.50
