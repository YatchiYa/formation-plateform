# Configuration du kit. Une ligne = une valeur. Charger avec : source scripts/config.sh config/test.env

# Projet et région
PROJECT_ID=mon-projet
REGION=europe-west4          # RAG Engine GA en Europe : europe-west3, europe-west4
PREFIX=rag-kit               # préfixe de tous les noms

# Modèle de réponse. Défaut : gemini-2.5-flash en europe-west4 (stable, tout reste dans l'UE).
# Option : MODEL=gemini-3.5-flash + MODEL_LOCATION=global (plus récent, mais 429 fréquents sur projet neuf, vérifié).
MODEL=gemini-2.5-flash
MODEL_LOCATION=europe-west4

# Synchro et sources
SYNC_SCHEDULE="*/5 * * * *"                        # filet de sécurité : toutes les 5 min (Europe/Paris)
PUSH=true                                          # notifications push Drive : synchro en quelques secondes
DRIVE_FOLDERS=""                                   # ID de dossiers Drive, séparés par des espaces (facultatif)

# Qui peut ouvrir l'interface (les propriétaires du projet le peuvent toujours)
USERS="user:moi@exemple.com group:equipe@exemple.com"

# Qualité / coût
LAYOUT_PARSER=true           # Document AI pour les PDF (tableaux, titres) ; false = parsing simple, gratuit
RAG_TIER=basic               # palier RagManagedDb : basic (≈ 91 €/mois, voir docs/08) ; scaled ; vide = ne pas toucher

# Hybride (sous-projet 3) : chercher AUSSI dans une app Gemini Enterprise (ses data stores). Vide = kit 1 seul.
GE_SERVING_CONFIG=
