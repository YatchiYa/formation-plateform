# Kit RAG Gemini Enterprise natif. Charger : source scripts/config.sh config/test.env
PROJECT_ID=main-project-511608
GE_LOCATION=eu                 # comme l'app Gemini Enterprise (eu, us, global)
REGION=europe-west1            # bucket des dépôts et planification
PREFIX=rag-ge
APP_ID=                        # app existante (ex. Acme) ; vide = pas d'app (test) ou créée si CREATE_APP=true
CREATE_APP=false               # true exige un abonnement Gemini Enterprise
DEPOTS=true                    # data store « fichiers déposés » (bucket)
DEPOTS_SCHEDULE="*/15 * * * *" # resynchro du bucket (ajouts, modifications, suppressions)
