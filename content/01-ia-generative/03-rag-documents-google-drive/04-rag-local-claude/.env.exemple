# Configuration du RAG local. Copiée en .env au 1er lancement de ./rag (ne partagez pas .env : il contient vos clés).

# Claude (obligatoire pour les réponses ; l'indexation et la recherche marchent sans)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5      # ou claude-sonnet-5-5 (moins cher), claude-haiku-5-5 (le plus rapide)
CLAUDE_EFFORT=low                 # low | medium | high : profondeur de réflexion (et coût)

# Embeddings : auto = Voyage si VOYAGE_API_KEY est remplie, sinon modèle local (gratuit, sur votre machine)
EMBEDDINGS=auto
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
RERANK_MODEL=rerank-2.5
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Synchro automatique (secondes entre deux passes)
POLL_SECONDS=60

# Serveur (local uniquement)
PORT=8765
