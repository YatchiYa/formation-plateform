# Copy to .env, then: docker compose up -d --build
PORT=3000
SITE_URL=http://localhost:3000
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string
# "on" hides premium content behind sign-in (accounts not implemented yet: everyone sees a teaser)
PREMIUM_GATE=off
# How often content/ is rescanned, in ms
CONTENT_CACHE_MS=2000
